# Copy this file to .env and fill in real values locally.
NODE_ENV=development
SECRET=replace-with-at-least-32-random-characters
PORT=3000
DB_PATH=/absolute/path/to/advent.db
DATABASE_URL=file:/absolute/path/to/advent.db
APP_BASE_URL=http://localhost:3000
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=12 Movies of Christmas
ADMIN_USER=
ADMIN_PASS=
TRUST_PROXY_HOPS=0
